{
    "manifest_version": 3,
    "name": "Keenetic Routing Rule Switch",
    "version": "1.0.0",
    "description": "Массовое изменение параметров DNS-маршрутов Keenetic",

    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },

    "content_scripts": [
        {
            "matches": [
                "*://*.netcraze.link/*",
                "*://*.keenetic.net/*",
                "*://*.netcraze.io/*",
                "*://*.netcraze.club/*",
                "*://*.crazedns.ru/*",
                "*://*.netcraze.pro/*"
            ],
            "js": [
                "src/routes.js",
                "src/rci.js",
                "src/dialog.js",
                "src/content.js"
            ],
            "css": [
                "src/content.css"
            ],
            "run_at": "document_idle"
        }
    ]
}